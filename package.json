{
  "name": "client-platform-api",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/main.js",
    "start:dev": "npm run build && node --watch --env-file=.env dist/main.js",
    "db:migrate": "npm run build && node --env-file=.env dist/database/cli.js migrate",
    "db:seed": "npm run build && node --env-file=.env dist/database/cli.js seed",
    "db:maintenance": "npm run build && node --env-file=.env dist/database/cli.js maintenance",
    "owner:create": "npm run build && node --env-file=.env dist/database/cli.js owner",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.spec.js",
    "test:integration": "tsc -p tsconfig.test.json && node --env-file=.env --test dist-test/test/*.integration.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.1.0",
    "luxon": "^3.7.0",
    "mysql2": "^3.14.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/luxon": "^3.6.2",
    "@types/node": "^24.0.0",
    "typescript": "~5.9.2"
  }
}